{
  "name": "multitenant-booking-qa",
  "version": "1.0.0",
  "private": true,
  "description": "A small booking app and the tests that hold it honest — Firestore security rules and Playwright UI, both against the emulator.",
  "author": "Supakorn (NNEWNERR)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "app": "vite",
    "test": "npm run test:rules && npm run test:ui",
    "test:rules": "firebase emulators:exec --only firestore --project=demo-booking-qa \"npx vitest run\"",
    "test:ui": "firebase emulators:exec --only firestore,auth --project=demo-booking-qa \"npx playwright test\"",
    "test:ui:headed": "firebase emulators:exec --only firestore,auth --project=demo-booking-qa \"npx playwright test --headed\"",
    "emulator": "firebase emulators:start --only firestore,auth --project=demo-booking-qa",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "firebase": "^12.14.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
